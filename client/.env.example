# URL of the FastAPI backend (the server/ folder). On Vercel set this to your Render URL,
# e.g. https://algorithmic-rag-engine-api.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public URL of this site, used for canonical links, sitemap, robots and social images.
# On Vercel it falls back to the production domain automatically if left unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
